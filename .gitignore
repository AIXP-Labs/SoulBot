# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Claude Code local config
.claude/

# Environment (contains secrets)
**/.env
!**/.env.example

# OS
.DS_Store
Thumbs.db
desktop.ini

# Test / Cache
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.ipynb_checkpoints/
htmlcov/
.coverage

# Atomic write temp files (atomic replace pattern: write .tmp then rename)
*.tmp

# AIAP execution cache
**/.execution_cache/

# OTel observability — span files (default + custom paths + rotation archives)
# Default location: {agents_dir}/data/_spans.jsonl (cli.py _init_observability)
# Override: SOULBOT_SPANS_FILE env var
# Rotated/compressed: tools/cleanup_execution_cache.py produces _spans-YYYYMMDD.jsonl[.gz|.zst]
**/_spans.jsonl
**/_spans-*.jsonl*

# AIAP Creator evolution artifacts (per-package, local-only)
# Generated by soulbot_creator_evolution_aiap runs; not intended to be
# committed (contain absolute paths and stale version diffs).
**/.version_history/
**/.evolution_snapshot/
**/.pipeline_cache/
**/pipeline_run_metadata.json
**/protocol_alignment_result.json

# Manual backups — never commit
*.bak
*.backup*

# Logs / process IDs
*.log
*.pid

# Defensive: private keys / cloud credentials (foot-gun prevention)
*.pem
*.key
*.pkcs12
id_rsa*
id_ed25519*
credentials.json
service-account*.json
.netrc

# Node (frontend)
node_modules/

# Frontend (Vite)
frontend/.vite/
*.local
*.tsbuildinfo

# SoulBot runtime data — narrowed from broad `data/` so AIAP packages
# whose `data/` subdir contains committable init templates (e.g.
# intent_classifier/data/{registry,taxonomy}.json) are NOT swept up.
/data/
examples/*/data/
.realbot_schedules.json
.soulbot_schedules.json
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite

# Root-level cognitive-cycle memory (separate from the per-AIAP rule
# above; this is for the legacy / dev-mode cognitive_cycle_aiap when
# it writes to SoulBot/memory/ rather than its own package dir).
# Contains semantic/episodic/profiles + per-user context — never commit.
/memory/

# AIAP runtime state (per-package, contains user_id / session_id /
# turn content / timestamps — not for public redistribution).
# Use **/ prefix so rules match regardless of aiap_store location
# (examples/simple/aiap_store/, SoulBot_Agent/aiap/, etc.).

# Cognitive cycle: accumulated state + episodic memory
**/soulbot_cognitive_cycle_aiap/memory/context_manager.json
**/soulbot_cognitive_cycle_aiap/memory/schema.json
**/soulbot_cognitive_cycle_aiap/memory/pipeline_stage_snapshot.json
**/soulbot_cognitive_cycle_aiap/memory/attention_stats.json

# Chat AIAP: working state + per-user episodic/profiles
**/soulbot_chat_aiap/memory/working.json
**/soulbot_chat_aiap/memory/episodic/
**/soulbot_chat_aiap/memory/profiles/

# AIBP/AIVP bot runtime artifacts (DB + logs)
**/soulbot_aibp_bot_aiap/data/
**/soulbot_aivp_bot_aiap/data/

# Memory AIAP: accumulated daily journals; keep MEMORY.md template
**/soulbot_memory_aiap/filebased_memory/data/memory/*.md

# Windows reserved device names
nul
