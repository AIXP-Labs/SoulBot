# === AIBP Bot 配置 ===
# 复制为 .env 并填写实际值：cp .env.example .env

# --- 邮件账号 ---
AIBP_EMAIL_ADDRESS=aibot-mybot@gmail.com

# --- 凭证存储 ---
# env     = .env 文件（开发环境默认）
# keyring = 系统钥匙链（macOS Keychain / Windows Credential Locker，生产推荐）
AIBP_CREDENTIAL_STORE=env

# --- 认证方式 ---
# password     = App Password（Gmail 需 2FA）/ 授权码（QQ/163）
# oauth2_gmail = Gmail API OAuth2（无需密码，用 credentials.json）
AIBP_AUTH_METHOD=password

# password 模式（Gmail 填 App Password，QQ/163 填 16 位授权码，非登录密码）：
AIBP_EMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# oauth2_gmail 模式（推荐 Gmail 用户使用，password 模式时忽略）：
# 步骤：
#   1. Google Cloud Console → APIs & Services → Credentials → Create OAuth 2.0 Client ID (Desktop)
#   2. 下载 JSON 放入 python_tools/credentials.json
#   3. 运行: python python_tools/email_auth.py --init（弹浏览器授权）
#   4. 授权后自动生成 token.json，之后无需再授权
# AIBP_OAUTH2_CREDENTIALS=credentials.json
# AIBP_OAUTH2_TOKEN=token.json

# --- Bot 身份 ---
AIBP_BOT_NAME=MyBot
AIBP_OPERATOR=My Organization
AIBP_OPERATOR_CONTACT=https://github.com/myorg/issues

# --- 邮件服务器 ---
# Gmail/Outlook/Yahoo/QQ/163 等公共邮箱：自动检测，无需填写
# 私有域名（如 aibot-bot@mydomain.com）：取消注释并填写
# AIBP_IMAP_HOST=mail.mydomain.com
# AIBP_IMAP_PORT=993
# AIBP_SMTP_HOST=mail.mydomain.com
# AIBP_SMTP_PORT=587

# --- 监听模式 ---
# poll = 定时轮询（默认，简单可靠）
# idle = IMAP IDLE 实时推送（低延迟，仅 password 模式，QQ/163 不支持）
AIBP_WATCH_MODE=poll
AIBP_POLL_INTERVAL=30
# IDLE 超时（秒，仅 idle 模式，默认 900 = 15 分钟）
# AIBP_IDLE_TIMEOUT=900

# --- 发送速率限制 ---
AIBP_RATE_LIMIT_HOUR=20
AIBP_RATE_LIMIT_DAY=100

# --- 信任与社交行为 ---
# auto_welcome      = 自动回复 WELCOME（默认）
# require_approval  = 等待 operator 确认
# ignore            = 忽略陌生 agent
AIBP_INTRODUCE_MODE=auto_welcome
AIBP_DEFAULT_TRUST=T1
AIBP_MAX_AUTO_TRUST=T2

# --- AI 披露（EU Art.50 合规，2026-08-02 强制）---
AIBP_AI_DISCLOSURE=true
AIBP_LANGUAGE=en

# --- 数据保留（GDPR 合规）---
AIBP_DATA_RESIDENCY=local
# AIBP_DATA_RETENTION_DAYS=365
# AIBP_INSIGHT_RETENTION_DAYS=90

# --- 协议版本 ---
AIBP_VERSION=AIBP V1.0.0
